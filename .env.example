# ==============================================================================
# Willhaben Hunter Web — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual values.
# On pepnet.at, reuse ANTHROPIC_API_KEY from /opt/pepnet/openclaw/.env.
# ==============================================================================

# Anthropic API configuration for POST /api/analyze
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
ANALYZE_MAX_INPUT_CHARS=200000

# Server & container configuration
HOST=0.0.0.0
PORT=8000
HOST_PORT=8001
TZ=Europe/Vienna
LOG_LEVEL=info

# Scraper worker bounds (10-minute hard timeout, 30-minute result TTL)
SCRAPE_TIMEOUT_MS=600000
SCRAPE_RESULT_TTL_MS=1800000
